# ── Local Postgres ───────────────────────────────────────────────────────────
TM_JDBC_URL=jdbc:postgresql://localhost:5432/taskmanagement
TM_JDBC_USER=tm
DATABASE_PASSWORD=tm

# ── Clerk OIDC Configuration ──────────────────────────────────────────────────
# Replace <your-clerk-subdomain> with your actual Clerk instance URL from the Clerk Dashboard
OIDC_AUTH_SERVER_URL=https://<your-clerk-subdomain>.clerk.accounts.dev
OIDC_TOKEN_ISSUER=https://<your-clerk-subdomain>.clerk.accounts.dev
OIDC_CLIENT_ID=backend
OIDC_ROLE_CLAIM_PATH=role