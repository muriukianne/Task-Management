# Copy to backend/.env and fill in values.
# quarkus:dev loads this file automatically.
#
# This project runs EXCLUSIVELY against a local PostgreSQL instance.

# ── Local Postgres (default for quarkus:dev and packaged runs) ───────────────
# Create role/database per db/README.md before first run.
TM_JDBC_URL=jdbc:postgresql://localhost:5432/taskmanagement
TM_JDBC_USER=tm
DATABASE_PASSWORD=tm

# Docker Compose alternative (see repo docker-compose.yml):
# TM_JDBC_URL=jdbc:postgresql://localhost:5433/taskmanagement

# ── Unit/integration test database (used by `mvnw test` only) ────────────────
# application.properties %test profile points at this DB; it must exist on
# localhost:5432 with the same role (see db/README.md → "Test database").
#   taskmanagement_test  user: tm  password: tm

OIDC_AUTH_SERVER_URL=
OIDC_TOKEN_ISSUER=
OIDC_CLIENT_ID=backend
OIDC_ROLE_CLAIM_PATH=role
