# ── Local Environment & Secrets ──────────────────────────────────────────────
# Ignore real env files containing actual secrets/database passwords
.env
.env.local
.env.*.local

# Local file attachments storage (created at runtime when testing document uploads)
/uploads/
/storage/

# Local-only test signing key (public key is committed; never commit private keys)
src/test/resources/test-private-key.pem

