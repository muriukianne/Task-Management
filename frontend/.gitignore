# ── Dependencies ─────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js Build & Production Outputs ───────────────────────────────────────
/.next/
/out/
/build/
/dist/

# ── Testing Coverage ─────────────────────────────────────────────────────────
/coverage/

# ── Environment Files & Secrets ──────────────────────────────────────────────
# Ignore all actual local environment files containing real keys
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# EXCEPTION: Always track template example files in git
!.env.example
!.env.local.example

# ── Clerk Credentials & Cache ────────────────────────────────────────────────
# Exclude local Clerk session artifacts and state
/.clerk/

# ── Vercel Deployment Artifacts ──────────────────────────────────────────────
.vercel

# ── TypeScript & OS Junk ─────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts
.DS_Store
Thumbs.db

# ── Local Logs & Debugging ────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.pem