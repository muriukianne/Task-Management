# ── Clerk authentication keys (from the Clerk Dashboard) ──────────────────────
# Copy this file to .env.local and replace the placeholders with your real keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_YOUR_SECRET_KEY

# ── Backend API target (Quarkus REST base path) ───────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080/tm/api/v1
